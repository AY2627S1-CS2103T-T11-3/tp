<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root type="javafx.stage.Stage" title="Help - Command reference" resizable="true"
         width="820" height="700" minWidth="540" minHeight="420"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox styleClass="help-root">
        <VBox spacing="6" styleClass="help-header">
          <padding>
            <Insets top="22" right="24" bottom="18" left="24" />
          </padding>
          <Label text="Command reference" styleClass="help-title" />
          <Label text="Command formats and fields, available offline."
                 wrapText="true" styleClass="help-subtitle" />
        </VBox>

        <ScrollPane fx:id="commandScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="help-scroll">
          <content>
            <VBox fx:id="commandEntries" spacing="16" styleClass="help-content">
              <padding>
                <Insets top="20" right="24" bottom="24" left="24" />
              </padding>

              <Label text="UPPERCASE = value to supply   [ ] = optional   ... = repeatable. Type literal prefixes such as n/; omit the brackets. Command names are case-insensitive. Prefixes are case-sensitive."
                     wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-notation" />

              <!-- Command entry template: copy this VBox for each additional command. -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="add" styleClass="help-command-name" />
                  <Label text="Adds a student, guardian or colleague to the address book."
                         wrapText="true" styleClass="help-description" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <!-- Only the name is required; omitted contact type defaults to student. -->
                  <TextArea text="add n/NAME [p/PHONE] [e/EMAIL] [a/ADDRESS] [ct/CONTACT_TYPE] [yos/YEAR_OF_STUDY] [t/TAG]..."
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <VBox spacing="10">
                  <Label text="Required fields" styleClass="help-section-title" />
                  <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                      <ColumnConstraints minWidth="136" prefWidth="136" />
                      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="n/NAME" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Name; letters, digits and spaces. Must not be blank." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                  </GridPane>
                </VBox>

                <VBox spacing="10">
                  <Label text="Optional fields" styleClass="help-section-title" />
                  <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                      <ColumnConstraints minWidth="136" prefWidth="136" />
                      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="p/PHONE" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Phone number; at least 3 digits if supplied. Omit if unknown." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="e/EMAIL" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Email address in local-part@domain format if supplied. Omit if unknown." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="a/ADDRESS" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Address; must not be blank if supplied. Omit if unknown." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <Label text="ct/CONTACT_TYPE" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="student, guardian or colleague; case-insensitive full value. Defaults to student when omitted." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    <Label text="yos/YEAR_OF_STUDY" GridPane.rowIndex="4" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Optional for students only. Positive integer from 1 to 2147483647; omit if unknown. Rejected for guardians and colleagues." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="4" GridPane.columnIndex="1" />
                    <Label text="t/TAG" GridPane.rowIndex="5" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Tag; letters and digits only. Repeat t/ to add more tags." wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="5" GridPane.columnIndex="1" />
                  </GridPane>
                </VBox>

                <Label text="Use each non-tag prefix at most once. Tags are alphanumeric and repeatable. Each supplied value must not be blank." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Example" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="add n/Alice Tan p/91234567 e/alice@example.com a/1 Clementi Road ct/student yos/2 t/Year2" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- Filter command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                <VBox spacing="5">
                  <Label text="filter" styleClass="help-command-name" />
                  <Label text="Shows contacts matching all supplied criteria." wrapText="true" styleClass="help-description" />
                </VBox>
                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="filter [n/NAME] [ct/CONTACT_TYPE] [d/DEPARTMENT] [a/ADDRESS] [id/PERSON_ID]... [gid/GROUP_ID] [yos/YEAR_OF_STUDY] [t/TAG]..."
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>
                <Label text="Optional fields" styleClass="help-section-title" />
                <GridPane hgap="16" vgap="10">
                  <columnConstraints><ColumnConstraints minWidth="136" prefWidth="136" /><ColumnConstraints minWidth="0" hgrow="ALWAYS" /></columnConstraints>
                  <Label text="n/NAME" styleClass="help-field-name" GridPane.columnIndex="0" />
                  <Label text="Name; case-insensitive substring matching." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" />
                  <Label text="ct/CONTACT_TYPE" styleClass="help-field-name" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                  <Label text="student, guardian or colleague, or an unambiguous prefix such as stu; case-insensitive." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                  <Label text="d/DEPARTMENT" styleClass="help-field-name" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                  <Label text="Case-insensitive substring of a colleague's department; other contacts do not match." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                  <Label text="a/ADDRESS" styleClass="help-field-name" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                  <Label text="Address; case-insensitive substring matching." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                  <Label text="id/PERSON_ID" styleClass="help-field-name" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                  <Label text="Exact numeric Person ID, not a displayed contact-list index. Repeat id/ to match any supplied ID (OR); numeric duplicates are ignored." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                  <Label text="gid/GROUP_ID" styleClass="help-field-name" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                  <Label text="Exact numeric Group ID, not its position in the Groups panel. Only members of that group match." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                  <Label text="yos/YEAR_OF_STUDY" styleClass="help-field-name" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                  <Label text="Exact numeric year of study; only students with a recorded year match. Other contacts do not match." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                  <Label text="t/TAG" styleClass="help-field-name" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                  <Label text="Tag; exact, case-sensitive matching. Repeat to require every supplied tag (AND)." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1" />
                </GridPane>
                <Label text="Different criteria combine using AND. Repeated id/ values are alternatives (OR), while repeated t/ values must all match (AND). Omit all fields to show all contacts. Each filter searches all contacts, replacing the previous filter."
                       wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />

                <Label text="Only id/ and t/ may repeat; each other prefix, including gid/ and yos/, may appear at most once. Supplied values must not be blank. Text phrases match contiguous substrings; tags match the whole value." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />
                <Label text="Numeric values must be positive integers from 1 to 2147483647; leading zeros do not change their value. Unknown IDs or criteria with no matches show zero contacts." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />
                <Label text="filter gid/ selects an actual numeric Group ID; link gid/ selects a displayed group-list index. Group IDs may change after restarting the application." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Examples: use your contacts' and groups' actual IDs." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="filter ct/stu a/Clementi t/Year2" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                  <TextArea text="filter id/12 id/13 yos/2 t/Student" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                  <TextArea text="filter gid/3 yos/2 t/Year2" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- Add group command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                <VBox spacing="5">
                  <Label text="addgroup" styleClass="help-command-name" />
                  <Label text="Creates a class or department group." wrapText="true" styleClass="help-description" />
                </VBox>
                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="addgroup GROUP_NAME gt/GROUP_TYPE"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>
                <Label text="Required fields" styleClass="help-section-title" />
                <GridPane hgap="16" vgap="10">
                  <columnConstraints><ColumnConstraints minWidth="136" prefWidth="136" /><ColumnConstraints minWidth="0" hgrow="ALWAYS" /></columnConstraints>
                  <Label text="GROUP_NAME" styleClass="help-field-name" GridPane.columnIndex="0" />
                  <Label text="Letters, digits and spaces; start with a letter or digit. Hyphens are not allowed." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" />
                  <Label text="gt/GROUP_TYPE" styleClass="help-field-name" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                  <Label text="class or department." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                </GridPane>
                <Label text="Place the group name before gt/. The group type is case-insensitive. Group names must not be blank."
                       wrapText="true" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Example" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="addgroup Class 2A gt/class" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- Delete group command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                <VBox spacing="5">
                  <Label text="deletegroup" styleClass="help-command-name" />
                  <Label text="Deletes the group at the displayed group-list index." wrapText="true" styleClass="help-description" />
                </VBox>
                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="deletegroup INDEX"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>
                <Label text="Required fields" styleClass="help-section-title" />
                <GridPane hgap="16" vgap="10">
                  <columnConstraints><ColumnConstraints minWidth="136" prefWidth="136" /><ColumnConstraints minWidth="0" hgrow="ALWAYS" /></columnConstraints>
                  <Label text="INDEX" styleClass="help-field-name" GridPane.columnIndex="0" />
                  <Label text="Positive group number in the currently displayed group list." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" />
                </GridPane>
                <Label text="Count groups from 1 in the Groups panel, not the contact list. Deleting a group unassigns its members but keeps the contacts."
                       wrapText="true" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Example: requires a group at position 1 in the Groups panel." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="deletegroup 1" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- Link group command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                <VBox spacing="5">
                  <Label text="link" styleClass="help-command-name" />
                  <Label text="Links a student to a class or a colleague to a department." wrapText="true" styleClass="help-description" />
                </VBox>
                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="link pid/PERSON_INDEX gid/GROUP_INDEX"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>
                <Label text="Required fields" styleClass="help-section-title" />
                <GridPane hgap="16" vgap="10">
                  <columnConstraints><ColumnConstraints minWidth="136" prefWidth="136" /><ColumnConstraints minWidth="0" hgrow="ALWAYS" /></columnConstraints>
                  <Label text="pid/PERSON_INDEX" styleClass="help-field-name" GridPane.columnIndex="0" />
                  <Label text="Positive position of the student or colleague in the currently displayed contact list, including filtered results; not the permanent contact ID." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" />
                  <Label text="gid/GROUP_INDEX" styleClass="help-field-name" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                  <Label text="Positive position of an existing class or department in the Groups panel, counting from 1; not a permanent group ID." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                </GridPane>
                <Label text="Students join classes; colleagues join departments; guardians cannot join groups. Linking to another group replaces the previous assignment. Use each prefix once."
                       wrapText="true" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Example: requires a student at contact-list position 1 and a class at group-list position 2." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="link pid/1 gid/2" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- Link guardian command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                <VBox spacing="5">
                  <Label text="link-guardian" styleClass="help-command-name" />
                  <Label text="Links a guardian to a student using displayed contact-list indices." wrapText="true" styleClass="help-description" />
                </VBox>
                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="link-guardian s/STUDENT_INDEX g/GUARDIAN_INDEX"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>
                <Label text="Required fields" styleClass="help-section-title" />
                <GridPane hgap="16" vgap="10">
                  <columnConstraints><ColumnConstraints minWidth="136" prefWidth="136" /><ColumnConstraints minWidth="0" hgrow="ALWAYS" /></columnConstraints>
                  <Label text="s/STUDENT_INDEX" styleClass="help-field-name" GridPane.columnIndex="0" />
                  <Label text="Positive student number in the displayed contact list." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" />
                  <Label text="g/GUARDIAN_INDEX" styleClass="help-field-name" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                  <Label text="Positive guardian number in the displayed contact list." wrapText="true" minWidth="0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                </GridPane>
                <Label text="Use the current displayed contact list; s/ must identify a student and g/ must identify a guardian."
                       wrapText="true" styleClass="help-note" />
              </VBox>

              <!-- Edit command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="edit"
                         styleClass="help-command-name" />
                  <Label text="Updates a contact in the displayed list."
                         wrapText="true" styleClass="help-description" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="edit INDEX [n/NAME] [p/PHONE] [e/EMAIL] [a/ADDRESS] [t/TAG]..."
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <VBox spacing="10">
                  <Label text="Required fields"
                         styleClass="help-section-title" />
                  <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                      <ColumnConstraints minWidth="136" prefWidth="136" />
                      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="INDEX"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Positive position in the currently displayed contact list, including filtered results; not the permanent contact ID."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                  </GridPane>
                </VBox>

                <VBox spacing="10">
                  <Label text="Optional fields"
                         styleClass="help-section-title" />
                  <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                      <ColumnConstraints minWidth="136" prefWidth="136" />
                      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="n/NAME"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="New name; letters, digits and spaces."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="p/PHONE"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="New phone number; at least 3 digits."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="e/EMAIL"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="New email address in local-part@domain format."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <Label text="a/ADDRESS"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="New address; must not be blank."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    <Label text="t/TAG"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Replaces the contact's existing tags. Use t/TAG for each tag you want to keep. Use t/ with no value to remove all tags. Leave out t/ to keep the current tags unchanged."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="4" GridPane.columnIndex="1" />
                  </GridPane>
                </VBox>

                <Label text="Provide at least one field. Use each non-tag prefix once. Editing resets the contact list to show all contacts. Contact type, year of study and group membership cannot be edited here."
                       wrapText="true" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Example: requires a contact at position 1; also clears its tags." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="edit 1 p/91234567 t/" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- Delete command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="delete"
                         styleClass="help-command-name" />
                  <Label text="Deletes the contact at the displayed index."
                         wrapText="true" styleClass="help-description" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="delete INDEX"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <VBox spacing="10">
                  <Label text="Required fields"
                         styleClass="help-section-title" />
                  <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                      <ColumnConstraints minWidth="136" prefWidth="136" />
                      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="INDEX"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="help-field-name" />
                    <Label text="Positive position in the currently displayed contact list, including filtered results; not the permanent contact ID."
                           wrapText="true" minWidth="0" maxWidth="Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                  </GridPane>
                </VBox>

                <Label text="Deleting a contact also removes guardian-student relationships involving it. There is no confirmation step." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />

                <VBox spacing="8">
                  <Label text="Example: requires a contact at position 1 in the current list." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-section-title" />
                  <TextArea text="delete 1" editable="false" wrapText="true"
                            minWidth="0" maxWidth="Infinity" styleClass="help-example" />
                </VBox>
              </VBox>

              <!-- List command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="list"
                         styleClass="help-command-name" />
                  <Label text="Displays all contacts and clears the active contact filter. Groups remain in the separate Groups panel."
                         wrapText="true" styleClass="help-description" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="list"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <Label text="No parameters required. Extra arguments are ignored." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />
              </VBox>

              <!-- Clear command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="clear"
                         styleClass="help-command-name" />
                  <Label text="Clears the address book, including contacts, groups and relationships."
                         wrapText="true" styleClass="help-description" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="clear"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <Label text="This removes all entries immediately, without confirmation. No undo command is available. Extra arguments are ignored." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />
              </VBox>

              <!-- Help command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="help"
                         styleClass="help-command-name" />
                  <Label text="Shows the command reference or brings it to the front if already open."
                         wrapText="true" styleClass="help-description" />
                  <Label text="Shortcut: F1"
                         wrapText="true" styleClass="help-note" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="help"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <Label text="No parameters required; extra arguments are ignored. Opening Help restores it if minimized. Feedback: Opened help window. The reference stays available while you use the main window." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />
              </VBox>

              <!-- Exit command -->
              <VBox spacing="14" styleClass="command-entry">
                <padding>
                  <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <VBox spacing="5">
                  <Label text="exit"
                         styleClass="help-command-name" />
                  <Label text="Closes the application."
                         wrapText="true" styleClass="help-description" />
                </VBox>

                <VBox spacing="8">
                  <Label text="Format" styleClass="help-section-title" />
                  <TextArea text="exit"
                            editable="false" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-syntax" />
                </VBox>

                <Label text="No parameters required. Extra arguments are ignored. Both the main window and Help window close." wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="help-note" />
              </VBox>

              <!-- Add more command-entry sections here, using the Add entry above as the template. -->
            </VBox>
          </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" styleClass="help-footer">
          <padding>
            <Insets top="12" right="24" bottom="12" left="24" />
          </padding>
          <Button text="Close" mnemonicParsing="false" cancelButton="true"
                  onAction="#hide" styleClass="help-close-button" />
        </HBox>
      </VBox>
    </Scene>
  </scene>
</fx:root>
