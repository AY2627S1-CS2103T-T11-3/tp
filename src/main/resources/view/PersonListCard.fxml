<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" spacing="8" minHeight="120" maxWidth="Infinity" GridPane.columnIndex="0">
      <padding>
        <Insets top="14" right="18" bottom="14" left="18" />
      </padding>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="index" styleClass="contact-index" />
        <Label fx:id="name" text="\$first" styleClass="contact-name" />
        <Label fx:id="role" styleClass="role_badge" text="\$role" />
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="yearOfStudy" styleClass="contact-meta" text="\$yearOfStudy" />
      </HBox>
      <GridPane hgap="24" vgap="8">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="145" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="180" />
        </columnConstraints>
        <Label fx:id="phone" styleClass="contact-detail" text="\$phone" GridPane.columnIndex="0" />
        <Label fx:id="email" styleClass="contact-detail" text="\$email" GridPane.columnIndex="1" />
        <Label fx:id="address" styleClass="contact-detail" wrapText="true" text="\$address"
               GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" />
      </GridPane>
      <Button fx:id="guardians" styleClass="guardian-button" mnemonicParsing="false" />
      <FlowPane fx:id="tags" hgap="7" vgap="3" />
    </VBox>
  </GridPane>
</HBox>
