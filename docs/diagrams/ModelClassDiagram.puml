@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Address
Class Email
Class Name
Class Phone
Class Tag
Class PersonId
Class Integer

Class Student
Class Guardian
Class Colleague

Class GroupList
Class "{abstract}\nGroup" as Group
Class ClassGroup
Class DepartmentGroup
Class GroupName


Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> "*" Tag
Person "1" *--> "1" PersonId
Person *--> "year of study" Integer

Student --|> Person
Guardian -left-|> Person
Colleague --|> Person

Person -[hidden]left-> Group
Student -[hidden]down-> Guardian
Student -[hidden]right-> Colleague
Guardian -[hidden]up-> Colleague

UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

AddressBook *--> "1" GroupList
GroupList --> "~* all" Group
Group *--> "1" GroupName
Group --> "*" PersonId

ClassGroup -right-|> Group
DepartmentGroup -[hidden]up-> ClassGroup
DepartmentGroup -right-|> Group

ModelManager --> "~* filtered" Person
@enduml
